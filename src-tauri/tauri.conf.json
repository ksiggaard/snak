{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "snak",
  "version": "0.6.1",
  "identifier": "com.snak.app",
  "build": {
    "beforeDevCommand": "npm run build:plugins && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:plugins && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "snak",
        "width": 1000,
        "height": 700,
        "minWidth": 640,
        "minHeight": 480,
        "resizable": true
      },
      {
        "label": "quick",
        "title": "snak — Quick input",
        "width": 640,
        "height": 160,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "center": true,
        "visible": false,
        "focus": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU1QzdEQjM5QTcxMTU2NjIKUldSaVZoR25PZHZINVFxWktPTXgwSnhVSm5YVVJMVzZ4TkJKL1JKbGd4dlB1OXBjQmR0TUhCdVoK",
      "endpoints": [
        "https://github.com/ksiggaard/snak/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "resources": ["resources/plugins/**/*"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "infoPlist": "Info.plist"
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libjavascriptcoregtk-4.1-0",
          "libgtk-3-0",
          "libssl3",
          "libsecret-1-0",
          "libayatana-appindicator3-1"
        ]
      }
    }
  }
}
